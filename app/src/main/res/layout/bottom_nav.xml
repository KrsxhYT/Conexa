<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="horizontal"
	android:background="@color/bg_secondary"
	android:paddingTop="8dp"
	android:paddingBottom="8dp"
	android:paddingLeft="6dp"
	android:paddingRight="6dp"
	android:elevation="6dp">
	<LinearLayout
		android:id="@+id/navHome"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:minHeight="54dp"
		android:paddingTop="4dp"
		android:paddingBottom="4dp"
		android:background="@drawable/bg_nav_item"
		android:gravity="center_horizontal|center_vertical"
		android:orientation="vertical"
		android:layout_weight="1">
		<ImageView
			android:id="@+id/navHomeIcon"
			android:layout_width="24dp"
			android:layout_height="24dp"
			android:src="@drawable/ic_home"
			android:scaleType="center"
			android:focusable="false"
			android:contentDescription="Home"
			app:tint="@color/text_secondary" />
		<TextView
			android:id="@+id/navHomeText"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:text="Home"
			android:textSize="11sp"
			android:textColor="@color/text_secondary"
			android:focusable="false" />
	</LinearLayout>
	<LinearLayout
		android:id="@+id/navFavorites"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:minHeight="54dp"
		android:paddingTop="4dp"
		android:paddingBottom="4dp"
		android:background="@drawable/bg_nav_item"
		android:gravity="center_horizontal|center_vertical"
		android:orientation="vertical"
		android:layout_weight="1">
		<ImageView
			android:id="@+id/navFavoritesIcon"
			android:layout_width="24dp"
			android:layout_height="24dp"
			android:src="@drawable/ic_star_outline"
			android:scaleType="center"
			android:focusable="false"
			android:contentDescription="Favorites"
			app:tint="@color/text_secondary" />
		<TextView
			android:id="@+id/navFavoritesText"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:text="Favorites"
			android:textSize="11sp"
			android:textColor="@color/text_secondary"
			android:focusable="false" />
	</LinearLayout>
	<LinearLayout
		android:id="@+id/navSettings"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:minHeight="54dp"
		android:paddingTop="4dp"
		android:paddingBottom="4dp"
		android:background="@drawable/bg_nav_item"
		android:gravity="center_horizontal|center_vertical"
		android:orientation="vertical"
		android:layout_weight="1">
		<ImageView
			android:id="@+id/navSettingsIcon"
			android:layout_width="24dp"
			android:layout_height="24dp"
			android:src="@drawable/ic_settings"
			android:scaleType="center"
			android:focusable="false"
			android:contentDescription="Settings"
			app:tint="@color/text_secondary" />
		<TextView
			android:id="@+id/navSettingsText"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:text="Settings"
			android:textSize="11sp"
			android:textColor="@color/text_secondary"
			android:focusable="false" />
	</LinearLayout>
	<LinearLayout
		android:id="@+id/navProfile"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:minHeight="54dp"
		android:paddingTop="4dp"
		android:paddingBottom="4dp"
		android:background="@drawable/bg_nav_item"
		android:gravity="center_horizontal|center_vertical"
		android:orientation="vertical"
		android:layout_weight="1">
		<ImageView
			android:id="@+id/navProfileIcon"
			android:layout_width="24dp"
			android:layout_height="24dp"
			android:src="@drawable/ic_profile"
			android:scaleType="center"
			android:focusable="false"
			android:contentDescription="Profile"
			app:tint="@color/text_secondary" />
		<TextView
			android:id="@+id/navProfileText"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:text="Profile"
			android:textSize="11sp"
			android:textColor="@color/text_secondary"
			android:focusable="false" />
	</LinearLayout>
</LinearLayout>
