<ScrollView
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/bg_primary"
	android:fitsSystemWindows="true"
	android:scrollbars="none">
	<LinearLayout
		android:id="@+id/linear45"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical">
		<LinearLayout
			android:id="@+id/linear46"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="18dp"
			android:orientation="horizontal">
			<ImageButton
				android:id="@+id/profileBackBtn"
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:padding="8dp"
				android:background="@drawable/bg_ripple"
				android:src="@drawable/ic_back"
				android:scaleType="center"
				app:tint="@color/text_primary" />
		</LinearLayout>
		<FrameLayout
			android:id="@+id/frame_layout47"
			android:layout_width="100dp"
			android:layout_height="100dp"
			android:layout_gravity="center_horizontal|center_vertical"
			android:elevation="3dp">
			<ImageView
				android:id="@+id/profileAvatarImage"
				android:layout_width="100dp"
				android:layout_height="100dp"
				android:background="@drawable/bg_avatar_2"
				android:src="@drawable/default_image"
				android:scaleType="centerCrop" />
			<TextView
				android:id="@+id/profileAvatarInitial"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:gravity="center_horizontal|center_vertical"
				android:textSize="36sp"
				android:textStyle="bold"
				android:textColor="#FFFFFF" />
		</FrameLayout>
		<TextView
			android:id="@+id/profileUserName"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="14dp"
			android:gravity="center_horizontal|center_vertical"
			android:textSize="24sp"
			android:textStyle="bold" />
		<TextView
			android:id="@+id/profileUserPhone"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:gravity="center_horizontal|center_vertical"
			android:textSize="15sp" />
		<LinearLayout
			android:id="@+id/linear48"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="18dp"
			android:gravity="center_horizontal|center_vertical"
			android:orientation="horizontal">
			<TextView
				android:id="@+id/editProfileBtn"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginRight="10dp"
				android:paddingLeft="24dp"
				android:paddingTop="12dp"
				android:paddingRight="24dp"
				android:paddingBottom="12dp"
				android:background="@drawable/bg_fab"
				android:text="Edit Profile"
				android:textSize="14sp"
				android:textStyle="bold"
				android:textColor="#FFFFFF"
				android:elevation="2dp" />
			<ImageButton
				android:id="@+id/profileShareBtn"
				android:layout_width="44dp"
				android:layout_height="44dp"
				android:padding="12dp"
				android:background="@drawable/bg_action_circle"
				android:src="@drawable/ic_share"
				android:scaleType="center"
				app:tint="@color/text_primary"
				android:elevation="1dp" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/linear49"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_margin="18dp"
			android:orientation="vertical"
			android:elevation="1dp">
			<TextView
				android:id="@+id/blockedContactsRow"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="Blocked Contacts"
				android:textSize="12sp"
				style="@style/SettingsRow"
				android:drawableStart="@drawable/ic_block"
				android:drawableEnd="@drawable/ic_chevron_right"
				android:drawableTint="@color/text_secondary" />
			<View
				android:id="@+id/view50"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				style="@style/SettingsDivider" />
			<TextView
				android:id="@+id/contactSettingsRow"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="Contact Settings"
				android:textSize="12sp"
				style="@style/SettingsRow"
				android:drawableStart="@drawable/ic_settings"
				android:drawableEnd="@drawable/ic_chevron_right"
				android:drawableTint="@color/text_secondary" />
			<View
				android:id="@+id/view51"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				style="@style/SettingsDivider" />
			<TextView
				android:id="@+id/importExportRow"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="Import / Export Contacts"
				android:textSize="12sp"
				style="@style/SettingsRow"
				android:drawableStart="@drawable/ic_share"
				android:drawableEnd="@drawable/ic_chevron_right"
				android:drawableTint="@color/text_secondary" />
			<View
				android:id="@+id/view52"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				style="@style/SettingsDivider" />
			<TextView
				android:id="@+id/aboutRow"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="About Conexa"
				android:textSize="12sp"
				style="@style/SettingsRow"
				android:drawableStart="@drawable/ic_profile"
				android:drawableEnd="@drawable/ic_chevron_right"
				android:drawableTint="@color/text_secondary" />
		</LinearLayout>
	</LinearLayout>
</ScrollView>
