<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:background="@color/bg_primary"
	android:fitsSystemWindows="true">

	<!-- Header -->
	<LinearLayout
		android:id="@+id/linear9"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingLeft="20dp"
		android:paddingTop="16dp"
		android:paddingRight="16dp"
		android:paddingBottom="12dp"
		android:gravity="center_vertical"
		android:orientation="horizontal">
		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:layout_weight="1">
			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/home_title"
				android:textColor="@color/text_primary"
				android:textSize="34sp"
				android:textStyle="bold"
				android:letterSpacing="-0.03"
				android:fontFamily="sans-serif-medium" />
			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="2dp"
				android:text="@string/home_subtitle"
				android:textColor="@color/text_tertiary"
				android:textSize="15sp" />
		</LinearLayout>
		<ImageButton
			android:id="@+id/addContactBtn"
			android:layout_width="40dp"
			android:layout_height="40dp"
			android:layout_marginRight="10dp"
			android:padding="9dp"
			android:background="@drawable/bg_add_contact"
			android:src="@drawable/ic_add"
			android:scaleType="center"
			android:contentDescription="@string/add_contact" />
		<ImageButton
			android:id="@+id/profileBtn"
			android:layout_width="40dp"
			android:layout_height="40dp"
			android:padding="9dp"
			android:background="@drawable/bg_avatar_2"
			android:src="@drawable/ic_profile"
			android:scaleType="center"
			android:contentDescription="Open profile"
			app:tint="#FFFFFF"
			android:elevation="1dp" />
	</LinearLayout>

	<!-- Search -->
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingLeft="16dp"
		android:paddingRight="16dp"
		android:paddingBottom="10dp"
		android:gravity="center_vertical"
		android:orientation="horizontal">
		<LinearLayout
			android:id="@+id/searchBar"
			android:layout_width="0dp"
			android:layout_height="48dp"
			android:paddingLeft="14dp"
			android:paddingRight="10dp"
			android:background="@drawable/bg_search_pill"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:layout_weight="1">
			<ImageView
				android:id="@+id/imageview4"
				android:layout_width="18dp"
				android:layout_height="18dp"
				android:src="@drawable/ic_search"
				android:scaleType="center"
				app:tint="@color/text_tertiary" />
			<EditText
				android:id="@+id/searchInput"
				android:layout_width="0dp"
				android:layout_height="match_parent"
				android:paddingLeft="10dp"
				android:textSize="17sp"
				android:hint="@string/search_hint"
				android:textColorHint="@color/text_tertiary"
				android:textColor="@color/text_primary"
				android:singleLine="true"
				android:imeOptions="actionSearch"
				android:layout_weight="1"
				android:background="@null" />
			<ImageButton
				android:id="@+id/clearSearchBtn"
				android:layout_width="28dp"
				android:layout_height="28dp"
				android:padding="5dp"
				android:background="@drawable/bg_ripple"
				android:src="@drawable/ic_close"
				android:scaleType="center"
				android:visibility="gone"
				app:tint="@color/text_tertiary" />
		</LinearLayout>
	</LinearLayout>

	<!-- Content -->
	<FrameLayout
		android:id="@+id/frame_layout10"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1">
		<ScrollView
			android:id="@+id/vscroll2"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:scrollbars="none"
			android:overScrollMode="never">
			<LinearLayout
				android:id="@+id/linear11"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical">

				<!-- Favorites Section -->
				<LinearLayout
					android:id="@+id/favoritesSection"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingTop="8dp"
					android:orientation="vertical">
					<TextView
						android:id="@+id/textview6"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:paddingLeft="20dp"
						android:paddingBottom="10dp"
						android:text="@string/favorites_title"
						android:textSize="13sp"
						android:textStyle="bold"
						android:textColor="@color/text_secondary"
						android:textAllCaps="true"
						android:letterSpacing="0.06" />
					<HorizontalScrollView
						android:id="@+id/hscroll2"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:scrollbars="none"
						android:overScrollMode="never">
						<LinearLayout
							android:id="@+id/favoritesRow"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:paddingLeft="16dp"
							android:paddingRight="16dp"
							android:orientation="horizontal" />
					</HorizontalScrollView>
				</LinearLayout>

				<!-- All Contacts Header -->
				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="16dp"
					android:paddingLeft="20dp"
					android:paddingRight="16dp"
					android:paddingBottom="6dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:layout_weight="1">
						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/all_contacts"
							android:textColor="@color/text_primary"
							android:textSize="20sp"
							android:textStyle="bold" />
						<TextView
							android:id="@+id/contactsCount"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="2dp"
							android:textColor="@color/text_tertiary"
							android:textSize="13sp" />
					</LinearLayout>
				</LinearLayout>

				<!-- Contacts List -->
				<androidx.recyclerview.widget.RecyclerView
					android:id="@+id/contactsRecyclerView"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:accessibilityLiveRegion="polite"
					android:paddingTop="4dp"
					android:paddingBottom="32dp"
					android:clipToPadding="false"
					android:overScrollMode="never" />
			</LinearLayout>
		</ScrollView>

		<!-- Empty State -->
		<LinearLayout
			android:id="@+id/emptyStateLayout"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:gravity="center_horizontal|center_vertical"
			android:orientation="vertical"
			android:visibility="gone"
			android:padding="40dp">
			<ImageView
				android:id="@+id/imageview5"
				android:layout_width="72dp"
				android:layout_height="72dp"
				android:src="@drawable/ic_empty_search"
				android:scaleType="center"
				app:tint="@color/text_quaternary" />
			<TextView
				android:id="@+id/emptyStateText"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:text="@string/no_contacts_found"
				android:textSize="17sp"
				android:textColor="@color/text_secondary"
				android:gravity="center" />
		</LinearLayout>

		<!-- Permission State -->
		<LinearLayout
			android:id="@+id/permissionLayout"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:padding="40dp"
			android:gravity="center_horizontal|center_vertical"
			android:orientation="vertical"
			android:visibility="gone">
			<ImageView
				android:id="@+id/imageview6"
				android:layout_width="72dp"
				android:layout_height="72dp"
				android:src="@drawable/ic_no_permission"
				android:scaleType="center"
				app:tint="@color/text_quaternary" />
			<TextView
				android:id="@+id/textview7"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:gravity="center"
				android:text="@string/permission_rationale_title"
				android:textSize="22sp"
				android:textStyle="bold"
				android:textColor="@color/text_primary" />
			<TextView
				android:id="@+id/textview8"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="10dp"
				android:gravity="center"
				android:text="@string/permission_rationale_desc"
				android:textSize="15sp"
				android:textColor="@color/text_secondary"
				android:lineSpacingExtra="3dp" />
			<TextView
				android:id="@+id/grantPermissionBtn"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="28dp"
				android:paddingLeft="32dp"
				android:paddingTop="14dp"
				android:paddingRight="32dp"
				android:paddingBottom="14dp"
				android:background="@drawable/bg_fab"
				android:text="@string/grant_access"
				android:textSize="16sp"
				android:textStyle="bold"
				android:textColor="#FFFFFF"
				android:elevation="2dp" />
		</LinearLayout>

		<!-- Loading -->
		<ProgressBar
			android:id="@+id/loadingSpinner"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			style="?android:progressBarStyle"
			android:layout_gravity="center"
			android:visibility="gone"
			android:indeterminateTint="@color/accent_primary" />
	</FrameLayout>

	<!-- Bottom Nav -->
	<include layout="@layout/bottom_nav" />
</LinearLayout>