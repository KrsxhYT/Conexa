<ScrollView
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/bg_primary"
	android:fitsSystemWindows="true"
	android:scrollbars="none">
	<LinearLayout
		android:id="@+id/linear23"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical">
		<LinearLayout
			android:id="@+id/linear24"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="18dp"
			android:gravity="center_vertical"
			android:orientation="horizontal">
			<ImageButton
				android:id="@+id/backBtn"
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:padding="8dp"
				android:background="@drawable/bg_ripple"
				android:src="@drawable/ic_back"
				android:scaleType="center"
				app:tint="@color/text_primary" />
			<View
				android:id="@+id/view25"
				android:layout_width="0dp"
				android:layout_height="1dp"
				android:layout_weight="1" />
			<ImageButton
				android:id="@+id/editBtn"
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:padding="8dp"
				android:background="@drawable/bg_ripple"
				android:src="@drawable/ic_edit"
				android:scaleType="center"
				app:tint="@color/text_primary" />
			<ImageButton
				android:id="@+id/shareBtn"
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:layout_marginLeft="6dp"
				android:padding="8dp"
				android:background="@drawable/bg_ripple"
				android:src="@drawable/ic_share"
				android:scaleType="center"
				app:tint="@color/text_primary" />
		</LinearLayout>
		<ProgressBar
			android:id="@+id/detailLoadingIndicator"
			android:layout_width="40dp"
			android:layout_height="40dp"
			android:layout_gravity="center_horizontal"
			android:layout_marginTop="20dp"
			android:indeterminateTint="@color/accent_primary" />
		<FrameLayout
			android:id="@+id/frame_layout26"
			android:layout_width="120dp"
			android:layout_height="120dp"
			android:layout_marginTop="10dp"
			android:layout_gravity="center_horizontal|center_vertical"
			android:elevation="3dp">
			<ImageView
				android:id="@+id/detailAvatarImage"
				android:layout_width="120dp"
				android:layout_height="120dp"
				android:background="@drawable/bg_avatar_1"
				android:src="@drawable/default_image"
				android:clipToOutline="true"
				android:scaleType="centerCrop" />
			<TextView
				android:id="@+id/detailAvatarInitial"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:gravity="center_horizontal|center_vertical"
				android:textSize="42sp"
				android:textStyle="bold"
				android:textColor="#FFFFFF" />
		</FrameLayout>
		<TextView
			android:id="@+id/detailSubtitle"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="5dp"
			android:gravity="center"
			android:textColor="@color/text_secondary"
			android:textSize="14sp"
			android:visibility="gone" />
		<LinearLayout
			android:id="@+id/linear27"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="16dp"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:layout_gravity="center_horizontal|center_vertical">
			<TextView
				android:id="@+id/detailName"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:gravity="center_horizontal|center_vertical"
				android:textSize="26sp"
				android:textStyle="bold" />
			<ImageButton
				android:id="@+id/starBtn"
				android:layout_width="36dp"
				android:layout_height="36dp"
				android:layout_marginLeft="10dp"
				android:padding="4dp"
				android:background="@drawable/bg_ripple"
				android:src="@drawable/ic_star_outline"
				android:scaleType="center"
				app:tint="@color/accent_primary" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/linear28"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="24dp"
			android:paddingLeft="20dp"
			android:paddingRight="20dp"
			android:gravity="center_horizontal|center_vertical"
			android:orientation="horizontal">
			<LinearLayout
				android:id="@+id/callAction"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="vertical"
				android:layout_weight="1">
				<ImageButton
					android:id="@+id/imageview11"
					android:layout_width="56dp"
					android:layout_height="56dp"
					android:padding="16dp"
					android:background="@drawable/bg_action_circle"
					android:src="@drawable/ic_call"
					android:scaleType="center"
					android:clickable="false"
					android:elevation="1dp" />
				<TextView
					android:id="@+id/textview13"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="6dp"
					android:text="Call"
					android:textSize="12sp" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/messageAction"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="vertical"
				android:layout_weight="1">
				<ImageButton
					android:id="@+id/imageview12"
					android:layout_width="56dp"
					android:layout_height="56dp"
					android:padding="16dp"
					android:background="@drawable/bg_action_circle"
					android:src="@drawable/ic_message"
					android:scaleType="center"
					android:clickable="false"
					android:elevation="1dp" />
				<TextView
					android:id="@+id/textview14"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="6dp"
					android:text="Message"
					android:textSize="12sp" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/videoAction"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="vertical"
				android:layout_weight="1">
				<ImageButton
					android:id="@+id/imageview13"
					android:layout_width="56dp"
					android:layout_height="56dp"
					android:padding="16dp"
					android:background="@drawable/bg_action_circle"
					android:src="@drawable/ic_video"
					android:scaleType="center"
					android:clickable="false"
					android:elevation="1dp" />
				<TextView
					android:id="@+id/textview15"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="6dp"
					android:text="Video"
					android:textSize="12sp" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/shareAction"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="vertical"
				android:layout_weight="1">
				<ImageButton
					android:id="@+id/imageview14"
					android:layout_width="56dp"
					android:layout_height="56dp"
					android:padding="16dp"
					android:background="@drawable/bg_action_circle"
					android:src="@drawable/ic_share"
					android:scaleType="center"
					android:clickable="false"
					android:elevation="1dp" />
				<TextView
					android:id="@+id/textview16"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="6dp"
					android:text="Share"
					android:textSize="12sp" />
			</LinearLayout>
		</LinearLayout>
		<LinearLayout
			android:id="@+id/phoneListContainer"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_margin="18dp"
			android:orientation="vertical" />
		<LinearLayout
			android:id="@+id/linear29"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginLeft="18dp"
			android:layout_marginTop="10dp"
			android:layout_marginRight="18dp"
			android:orientation="vertical">
			<TextView
				android:id="@+id/blockBtn"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="18dp"
				android:background="@drawable/bg_card"
				android:gravity="center_horizontal|center_vertical"
				android:text="Block Contact"
				android:textSize="16sp"
				android:textStyle="bold"
				android:elevation="1dp" />
		</LinearLayout>
		<View
			android:id="@+id/view30"
			android:layout_width="1dp"
			android:layout_height="30dp" />
	</LinearLayout>
</ScrollView>
